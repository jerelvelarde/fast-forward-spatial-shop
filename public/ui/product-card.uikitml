<style>
  @font-face { font-family: "DM Sans"; src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf"); font-weight: 400; }
  @font-face { font-family: "DM Sans"; src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf"); font-weight: 700; }

  .card { font-family: "DM Sans"; width: 72; height: 88; flex-direction: column; background-color: #17221f; border-radius: 4; border-width: 0.2; border-color: #46554a; padding-top: 3; padding-bottom: 3; padding-left: 3; padding-right: 3; gap: 2; color: #f0f3e9; cursor: pointer; }
  .image { width: 66; height: 43; border-radius: 2; background-color: #ffffff; }
  .seller { font-size: 2.1; color: #b0b9aa; height: 4; }
  .title { font-size: 3.6; height: 11; font-weight: bold; }
  .price { font-size: 4.2; color: #c8f36b; height: 6; }
  .action { width: 66; height: 8; align-items: center; justify-content: center; background-color: #c8f36b; color: #17221f; border-radius: 2; font-size: 2.8; }
</style>
<div id="card" class="card">
  <div id="seller" class="seller">LIVE SHOPIFY CATALOG</div>
  <img id="image" class="image" object-fit="cover" src="/ui/placeholder.svg" />
  <div id="title" class="title">Find your next adventure.</div>
  <div id="price" class="price">Live price</div>
  <button id="select" class="action"><span id="select-label">Search to discover</span></button>
</div>
