<style>
  @font-face { font-family: "DM Sans"; src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf"); font-weight: 400; }
  @font-face { font-family: "DM Sans"; src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf"); font-weight: 700; }

 .root { font-family: "DM Sans"; width: 194; height: 67; background-color: #17221f; border-radius: 4; border-width: 0.15; border-color: #46554a; flex-direction: column; align-items: center; gap: 3; padding-top: 4; padding-bottom: 4; color: #f0f3e9; }
 .row { flex-direction: row; gap: 3; }
 .button { height: 13; width: 44; justify-content: center; align-items: center; border-radius: 3; background-color: #2e4036; font-size: 3.3; cursor: pointer; }
 .primary { background-color: #c8f36b; color: #17221f; }
 .wide { width: 180; }
 #primary-row { flex-direction: column; }
 #prev { display: none; }
 #next { display: none; }
 #back { display: none; }
 .utility { height: 10; font-size: 2.8; }
 .caption { width: 180; height: 8; font-size: 3; color: #c1cdbf; text-align: center; }
</style>
<div id="root" class="root">
 <div id="primary-row" class="row"><button id="voice" class="button primary wide"><span id="voice-label">Speak your request</span></button><button id="search" class="button wide">Try backpack search</button><button id="prev" class="button">Previous</button><button id="next" class="button">Next</button></div>
 <div class="row"><button id="back" class="button utility">Browse products</button><button id="rotate" class="button utility">Rotate preview</button><button id="recenter" class="button utility">Bring UI here</button><button id="exit" class="button utility">Exit to browser</button></div>
 <div id="caption" class="caption">Point and pinch, or use a controller trigger.</div>
</div>
