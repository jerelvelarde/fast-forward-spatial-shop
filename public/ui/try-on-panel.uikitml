<style>
  @font-face { font-family: "DM Sans"; src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf"); font-weight: 400; }
  @font-face { font-family: "DM Sans"; src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf"); font-weight: 700; }

 .root { font-family: "DM Sans"; width: 100; height: 101; background-color: #17221f; border-radius: 4; padding-left: 4; padding-right: 4; padding-top: 4; gap: 3; flex-direction: column; color: #f0f3e9; }
 .title { font-size: 4; font-weight: bold; }
 .image { width: 92; height: 56; border-radius: 2; }
 .status { font-size: 2.8; height: 17; }
 .label { font-size: 2; color: #c8f36b; }
</style>
<div class="root"><div class="label">YOUR PHOTO PREVIEW</div><div class="title">See your selection.</div><img id="preview" class="image" object-fit="cover" src="/ui/placeholder.svg"/><div id="status" class="status">Choose a product, then add your photo in the browser.</div></div>
