<style>
  @font-face { font-family: "DM Sans"; src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf"); font-weight: 400; }
  @font-face { font-family: "DM Sans"; src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf"); font-weight: 700; }

 .root { font-family: "DM Sans"; width: 88; height: 108; background-color: #17221f; border-radius: 4; border-width: 0.2; border-color: #c8f36b; padding-left: 4; padding-right: 4; padding-top: 4; padding-bottom: 4; gap: 2; flex-direction: column; color: #f0f3e9; }
 .title { font-size: 3.9; font-weight: bold; height: 12; }
 .image { align-self: center; width: 80; height: 32; border-radius: 2; background-color: #ffffff; }
 .status { font-size: 3; height: 12; color: #c1cdbf; }
 .action { width: 80; height: 13; border-radius: 3; background-color: #c8f36b; color: #17221f; font-size: 3.5; align-items: center; justify-content: center; cursor: pointer; }
 .actions { flex-direction: row; gap: 2; }
 .secondary { width: 39; height: 11; background-color: #2e4036; color: #f0f3e9; font-size: 3; }
 .label { font-size: 2.6; color: #c8f36b; height: 4; }
</style>
<div id="root" class="root"><div id="selection-label" class="label">YOUR PICK</div><div id="preview-title" class="title">Choose a product</div><img id="preview" class="image" object-fit="cover" src="/ui/placeholder.svg"/><div id="status" class="status">Selected. See it in your space.</div><button id="model" class="action"><span id="model-label">See it in my room</span></button><div class="actions"><button id="try-selected" class="action secondary">Photo preview</button><button id="buy-selected" class="action secondary">Buy selected</button></div></div>
