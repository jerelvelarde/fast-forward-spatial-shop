{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@iwsdk/vite-plugin-dev/client", "node"]
  },
  "include": ["src/**/*.ts", "server/**/*.ts", "api/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
