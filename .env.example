# Copy to .env.local. Never commit real credentials or use a VITE_ prefix.
# Powers speech transcription and image try-on through Vercel AI Gateway.
AI_GATEWAY_API_KEY=
AI_GATEWAY_IMAGE_MODEL=google/gemini-3.1-flash-image
# Use a random private value with at least 16 characters. Enter it in the try-on UI.
TRY_ON_ACCESS_TOKEN=
MESHY_API_KEY=
